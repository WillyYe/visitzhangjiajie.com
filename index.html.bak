    /* ========== NEWS CAROUSEL STATE & FUNCTIONS ========== */
    var NewsCarouselState = {
      currentSlide: 0,
      totalSlides: 0,
      autoplayTimer: null,
      progressTimer: null,
      autoplayDelay: 5000,
      isPaused: false,
      touchStartX: 0,
      touchEndX: 0
    };

    function renderNewsCarousel(resetSlide) {
      if (resetSlide === undefined) resetSlide = true;
      var carousel = document.getElementById('newsCarousel');
      var dotsContainer = document.getElementById('newsCarouselDots');
      if (!carousel || !dotsContainer) return;
      
      var cardsPerSlide = window.innerWidth < 768 ? 1 : (window.innerWidth <= 1024 ? 2 : 3);
      var totalSlides = Math.ceil(newsData.length / cardsPerSlide);
      NewsCarouselState.totalSlides = totalSlides;
      if (resetSlide) NewsCarouselState.currentSlide = 0;
      
      var html = '';
      for (var i = 0; i < totalSlides; i++) {
        html += '<div class="news-carousel-slide">';
        var startIdx = i * cardsPerSlide;
        var endIdx = Math.min(startIdx + cardsPerSlide, newsData.length);
        for (var j = startIdx; j < endIdx; j++) {
          var item = newsData[j];
          html += '<a href="news-detail.html?id=' + j + '" class="news-carousel-card">';
          html += '<div class="news-carousel-img" style="background-image: url(\'' + escapeHtml(item.img) + '\')">';
          html += '<div class="news-date">';
          html += '<div class="news-date-day">' + escapeHtml(item.date.day) + '</div>';
          html += '<div>' + escapeHtml(item.date.month) + '</div>';
          html += '</div>';
          html += '<div class="news-tag">' + escapeHtml(item.tag.toUpperCase()) + '</div>';
          html += '</div>';
          html += '<div class="news-carousel-body">';
          html += '<h3 class="news-carousel-title">' + escapeHtml(item.titleEn) + '</h3>';
          html += '<p class="news-carousel-text">' + escapeHtml(item.descEn) + '</p>';
          html += '</div></a>';
        }
        html += '</div>';
      }
      carousel.innerHTML = html;
      
      // Render dots
      var dotsHtml = '';
      for (var i = 0; i < totalSlides; i++) {
        dotsHtml += '<button class="news-carousel-dot' + (i === 0 ? ' active' : '') + '" data-slide="' + i + '" aria-label="Go to slide ' + (i + 1) + '"></button>';
      }
      dotsContainer.innerHTML = dotsHtml;
      
      // Reset and start autoplay
      stopNewsAutoplay();
      startNewsAutoplay();
    }

    function goToNewsSlide(index) {
      if (NewsCarouselState.totalSlides <= 1) return;
      var carousel = document.getElementById('newsCarousel');
      if (!carousel) return;
      
      NewsCarouselState.currentSlide = index;
      carousel.style.transform = 'translateX(-' + (index * 100) + '%)';
      
      // Update dots
      document.querySelectorAll('.news-carousel-dot').forEach(function(dot, i) {
        dot.classList.toggle('active', i === index);
      });
      
      // Reset autoplay
      if (!NewsCarouselState.isPaused) {
        stopNewsAutoplay();
        startNewsAutoplay();
      }
    }

    function nextNewsSlide() {
      var next = (NewsCarouselState.currentSlide + 1) % NewsCarouselState.totalSlides;
      goToNewsSlide(next);
    }

    function prevNewsSlide() {
      var prev = (NewsCarouselState.currentSlide - 1 + NewsCarouselState.totalSlides) % NewsCarouselState.totalSlides;
      goToNewsSlide(prev);
    }

    function startNewsAutoplay() {
      stopNewsAutoplay();
      NewsCarouselState.autoplayTimer = setInterval(nextNewsSlide, NewsCarouselState.autoplayDelay);
      startProgressBar();
    }

    function stopNewsAutoplay() {
      if (NewsCarouselState.autoplayTimer) {
        clearInterval(NewsCarouselState.autoplayTimer);
        NewsCarouselState.autoplayTimer = null;
      }
      stopProgressBar();
    }

    function startProgressBar() {
      stopProgressBar();
      var progress = document.getElementById('newsCarouselProgress');
      if (!progress) return;
      var startTime = Date.now();
      NewsCarouselState.progressTimer = setInterval(function() {
        if (NewsCarouselState.isPaused) return;
        var elapsed = Date.now() - startTime;
        var pct = Math.min((elapsed / NewsCarouselState.autoplayDelay) * 100, 100);
        progress.style.width = pct + '%';
      }, 50);
    }

    function stopProgressBar() {
      if (NewsCarouselState.progressTimer) {
        clearInterval(NewsCarouselState.progressTimer);
        NewsCarouselState.progressTimer = null;
      }
      var progress = document.getElementById('newsCarouselProgress');
      if (progress) progress.style.width = '0%';
    }

    function pauseNewsCarousel() {
      NewsCarouselState.isPaused = true;
      stopNewsAutoplay();
    }

    function resumeNewsCarousel() {
      NewsCarouselState.isPaused = false;
      startNewsAutoplay();
    }

    function handleNewsTouchStart(e) {
      NewsCarouselState.touchStartX = e.touches[0].clientX;
      pauseNewsCarousel();
    }

    function handleNewsTouchMove(e) {
      NewsCarouselState.touchEndX = e.touches[0].clientX;
    }

    function handleNewsTouchEnd() {
      if (NewsCarouselState.touchStartX === 0) { resumeNewsCarousel(); return; }
      var diff = NewsCarouselState.touchStartX - NewsCarouselState.touchEndX;
      var threshold = 50;
      if (diff > threshold) {
        nextNewsSlide();
      } else if (diff < -threshold) {
        prevNewsSlide();
      }
      window._newsSwiped = true;
      setTimeout(function() { window._newsSwiped = false; }, 500);
      resumeNewsCarousel();
    }

    function renderExperience() {
      var grid = document.getElementById('expGrid');
      var html = '';
      
      expData.forEach(function(item) {
        html += '<a href="exp-detail.html?id=' + escapeHtml(item.id) + '" class="exp-card">';
        html += '<div class="exp-img"><img src="' + escapeHtml(item.img) + '" alt="' + escapeHtml(item.titleEn) + '" loading="lazy"></div>';
        html += '<div class="exp-body">';
        html += '<h4 class="exp-title">' + escapeHtml(item.titleEn) + '</h4>';
        html += '<p class="exp-desc">' + escapeHtml(item.descEn) + '</p>';
        html += '</div></a>';
      });
      
      grid.innerHTML = html;
    }

    function renderScenic() {
      try {
        console.log('[renderScenic] START, AppState.scenicPage =', AppState.scenicPage);
        var container = document.getElementById('scenicGrid');
        var pagination = document.getElementById('scenicPagination');
        if (!container) { console.error('[renderScenic] ERROR: scenicGrid not found'); return; }
        if (!pagination) { console.error('[renderScenic] ERROR: scenicPagination not found'); return; }
        
        
        var itemsPerPage = 3;
        var totalPages = Math.ceil(scenicData.length / itemsPerPage);
        var currentPage = AppState.scenicPage || 1;
        
                
        // Calculate start and end indices
        var startIdx = (currentPage - 1) * itemsPerPage;
        var endIdx = Math.min(startIdx + itemsPerPage, scenicData.length);
        var pageItems = scenicData.slice(startIdx, endIdx);
        
        console.log('[renderScenic] Rendering items', startIdx, 'to', (endIdx-1), '(', pageItems.length, 'items)');
        
        // Render current page items
        var html = '';
        pageItems.forEach(function(item, idx) {
          console.log('[renderScenic] Item', idx, ':', item.id, ', img:', item.img);
          html += '<a href="' + item.href + '" class="scenic-card fade-up">';
          html += '<div class="scenic-bg" style="background-image: url(\'' + escapeHtml(item.img) + '\')"></div>';
          html += '<div class="scenic-overlay">';
          html += '<div class="scenic-tag">' + escapeHtml(item.tagEn) + '</div>';
          html += '<h3 class="scenic-name">' + escapeHtml(item.nameEn) + '</h3>';
          html += '<p class="scenic-sub">' + escapeHtml(item.subTitleEn) + '</p>';
          html += '<p class="scenic-desc">' + escapeHtml(item.descEn) + '</p>';
          html += '<span class="scenic-link">' + escapeHtml('Explore More →') + '</span>';
          html += '</div></a>';
        });
        
        console.log('[renderScenic] Setting innerHTML, length =', html.length);
        container.innerHTML = html;
        
        // IMPORTANT: Show cards IMMEDIATELY (don't wait for images)
        var cards = container.querySelectorAll('.fade-up');
        console.log('[renderScenic] Found', cards.length, 'cards, adding .visible');
        cards.forEach(function(el) {
          el.classList.add('visible');
        });
        
        // Preload background images (non-blocking, for debugging only)
        var bgElements = container.querySelectorAll('.scenic-bg');
        console.log('[renderScenic] Preloading', bgElements.length, 'background images');
        bgElements.forEach(function(bg, idx) {
          var style = bg.style.backgroundImage;
          var urlMatch = style.match(/url\(['"]?([^'"]+)['"]?\)/);
          if (urlMatch && urlMatch[1]) {
            var img = new Image();
            img.onload = function() { console.log('[renderScenic] Image', idx, 'loaded:', urlMatch[1]); };
            img.onerror = function() { console.error('[renderScenic] Image', idx, 'FAILED:', urlMatch[1]); };
            img.src = urlMatch[1];
          }
        });
        
        // Render pagination dots
        var dotsHtml = '';
        for (var i = 1; i <= totalPages; i++) {
          dotsHtml += '<button class="pagination-dot' + (i === currentPage ? ' active' : '') + '" onclick="goToScenicPage(' + i + ')"></button>';
        }
        console.log('[renderScenic] Rendering', totalPages, 'pagination dots');
        pagination.innerHTML = dotsHtml;
        
        console.log('[renderScenic] COMPLETED successfully');
      } catch(e) {
        console.error('[renderScenic] ERROR:', e.message, e.stack);
      }
    }

    function goToScenicPage(page) {
      AppState.scenicPage = page;
      renderScenic();
    }

    function renderGallery() {
      var masonry = document.getElementById('galleryMasonry');
      var html = '';
      
      galleryData.forEach(function(item, index) {
        html += '<div class="gallery-item" data-category="' + escapeHtml(item.cat) + '" onclick="openLightbox(' + index + ')">';
        html += '<img src="' + escapeHtml(item.img) + '" alt="' + escapeHtml(item.titleEn) + '" loading="lazy" decoding="async">';
        html += '<div class="gallery-overlay">';
        html += '<span class="gallery-title">' + escapeHtml(item.titleEn) + '</span>';
        html += '</div></div>';
      });
      
      masonry.innerHTML = html;
    }

    /* ========== GALLERY FILTER ========== */
    function filterGallery(cat, btn) {
      document.querySelectorAll('.gallery-filter button').forEach(function(b) {
        b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');
      
      document.querySelectorAll('.gallery-item').forEach(function(item) {
        if (cat === 'all' || item.dataset.category === cat) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    /* ========== HERO SLIDER ========== */
    function startHeroSlider() {
      var slides = document.querySelectorAll('.hero-slide');
      var dots = document.querySelectorAll('.hero-dot');
      
      if (slides.length === 0 || dots.length === 0) return;
      
      if (AppState.heroSlider) {
        clearInterval(AppState.heroSlider);
      }
      
      AppState.heroSlider = setInterval(function() {
        requestAnimationFrame(function() {
          slides[AppState.currentSlide].classList.remove('active');
          dots[AppState.currentSlide].classList.remove('active');
          
          AppState.currentSlide = (AppState.currentSlide + 1) % slides.length;
          
          slides[AppState.currentSlide].classList.add('active');
          dots[AppState.currentSlide].classList.add('active');
        });
      }, 5000);
    }
    
    function goToSlide(index) {
      var slides = document.querySelectorAll('.hero-slide');
      var dots = document.querySelectorAll('.hero-dot');
      if (slides.length === 0 || dots.length === 0) return;
      
      slides[AppState.currentSlide].classList.remove('active');
      dots[AppState.currentSlide].classList.remove('active');
      
      AppState.currentSlide = index;
      
      slides[AppState.currentSlide].classList.add('active');
      dots[AppState.currentSlide].classList.add('active');
      
      clearInterval(AppState.heroSlider);
      startHeroSlider();
    }
    
    function toggleHeroAutoplay() {
      AppState.heroAutoplay = !AppState.heroAutoplay;
      var pauseBtn = document.querySelector('.hero-pause');
      if (pauseBtn) {
        pauseBtn.innerHTML = AppState.heroAutoplay ? '&#9646;&#9646;' : '&#9654;';
      }
      if (AppState.heroAutoplay) {
        startHeroSlider();
      } else {
        clearInterval(AppState.heroSlider);
      }
    }

    /* ========== LIGHTBOX ========== */
    var lightboxIndex = 0;
    
    function openLightbox(index) {
      // Bounds check
      if (index < 0 || index >= galleryData.length) return;
      lightboxIndex = index;
      var img = document.getElementById('lightboxImg');
      if (!img) return;
      
      // Transition effect
      img.classList.add('changing');
      setTimeout(function() {
        img.src = galleryData[index].img;
        img.alt = AppState.currentLang === 'zh' 
          ? galleryData[index].title 
          : galleryData[index].titleEn;
        img.classList.remove('changing');
      }, 150);
      
      document.getElementById('lightbox').classList.add('open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      
      // Update counter
      updateLightboxCounter();
    }
    
    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }
    
    function lightboxPrev() {
      var newIndex = (lightboxIndex - 1 + galleryData.length) % galleryData.length;
      openLightbox(newIndex);
    }
    
    function lightboxNext() {
      var newIndex = (lightboxIndex + 1) % galleryData.length;
      openLightbox(newIndex);
    }
    
    function updateLightboxCounter() {
      var counter = document.querySelector('.lightbox-counter');
      if (!counter) {
        counter = document.createElement('div');
        counter.className = 'lightbox-counter';
        var lightbox = document.getElementById('lightbox');
        if (lightbox) lightbox.appendChild(counter);
      }
      counter.textContent = (lightboxIndex + 1) + ' / ' + galleryData.length;
      
      // Update caption
      var caption = document.querySelector('.lightbox-caption');
      if (!caption) {
        caption = document.createElement('div');
        caption.className = 'lightbox-caption';
        var lightbox2 = document.getElementById('lightbox');
        if (lightbox2) lightbox2.appendChild(caption);
      }
      caption.textContent = AppState.currentLang === 'zh' 
        ? galleryData[lightboxIndex].title 
        : galleryData[lightboxIndex].titleEn;
    }

    /* ========== HEADER SCROLL ========== */
    function handleHeaderScroll() {
      var header = document.getElementById('header');
      if (window.scrollY > 100) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }

    /* ========== FADE ANIMATION ========== */
    function initFadeAnimation() {
      var fadeEls = document.querySelectorAll('.fade-up');
      
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries, obs) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        
        fadeEls.forEach(function(el) {
          observer.observe(el);
        });
      } else {
        fadeEls.forEach(function(el) {
          el.classList.add('visible');
        });
      }
    }

    /* ========== VIDEO ========== */
    function openVideo() {
      window.open('https://www.bilibili.com/video/BV1jZQjBuErL/', '_blank');
    }

    /* ========== INIT ========== */
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize autoplay state
      AppState.heroAutoplay = true;
      
      // Render dynamic content
      renderNewsCarousel();
      renderExperience();
      renderGallery();
      renderScenic();

      // Start hero slider
      startHeroSlider();
      
      // Header scroll - passive for better performance
      window.addEventListener('scroll', handleHeaderScroll, { passive: true });
      handleHeaderScroll();
      
      // Hero dots - event delegation (avoid memory leak)
      var heroDots = document.getElementById('heroDots');
      if (heroDots) {
        heroDots.addEventListener('click', function(e) {
          var dot = e.target.closest('.hero-dot');
          if (!dot) return;
          var slideIndex = parseInt(dot.dataset.slide, 10);
          if (!isNaN(slideIndex)) {
            goToSlide(slideIndex);
          }
        });
      }
      
      // Hero nav arrows
      var heroPrev = document.querySelector('.hero-nav.prev');
      var heroNext = document.querySelector('.hero-nav.next');
      if (heroPrev) {
        heroPrev.addEventListener('click', function() {
          var slides = document.querySelectorAll('.hero-slide');
          var newIndex = (AppState.currentSlide - 1 + slides.length) % slides.length;
          goToSlide(newIndex);
        });
      }
      if (heroNext) {
        heroNext.addEventListener('click', function() {
          var slides = document.querySelectorAll('.hero-slide');
          var newIndex = (AppState.currentSlide + 1) % slides.length;
          goToSlide(newIndex);
        });
      }
      
      // Hero pause button
      var heroPause = document.querySelector('.hero-pause');
      if (heroPause) {
        heroPause.addEventListener('click', toggleHeroAutoplay);
      }
      
      // News Carousel initialization
      var newsWrapper = document.getElementById('newsCarouselWrapper');
      if (newsWrapper) {
        // Navigation arrows
        var newsPrev = document.getElementById('newsCarouselPrev');
        var newsNext = document.getElementById('newsCarouselNext');
        if (newsPrev) newsPrev.addEventListener('click', prevNewsSlide);
        if (newsNext) newsNext.addEventListener('click', nextNewsSlide);
        
        // Dots - event delegation
        var newsDots = document.getElementById('newsCarouselDots');
        if (newsDots) {
          newsDots.addEventListener('click', function(e) {
            var dot = e.target.closest('.news-carousel-dot');
            if (!dot) return;
            var slideIndex = parseInt(dot.dataset.slide, 10);
            if (!isNaN(slideIndex)) {
              goToNewsSlide(slideIndex);
            }
          });
        }
        
        // Pause on hover
        newsWrapper.addEventListener('mouseenter', pauseNewsCarousel);
        newsWrapper.addEventListener('mouseleave', resumeNewsCarousel);
        
        // Touch swipe support
        var newsCarousel = document.getElementById('newsCarousel');
        if (newsCarousel) {
          newsCarousel.addEventListener('touchstart', handleNewsTouchStart, { passive: true });
          newsCarousel.addEventListener('touchmove', handleNewsTouchMove, { passive: true });
          newsCarousel.addEventListener('touchend', handleNewsTouchEnd, { passive: true });
        }
        
        // Handle resize - do not reset carousel position
        var resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function() {
            renderNewsCarousel(false);
          }, 250);
        });
      }
      
      // Fade animation
      initFadeAnimation();
      
      // Back to top button
      var backToTop = document.createElement('button');
      backToTop.className = 'back-to-top';
      backToTop.setAttribute('aria-label', 'Back to top');
      backToTop.innerHTML = '&#8593;';
      document.body.appendChild(backToTop);
      
      window.addEventListener('scroll', function() {
        if (window.scrollY > 500) {
          backToTop.classList.add('visible');
        } else {
          backToTop.classList.remove('visible');
        }
      }, { passive: true });
      
      backToTop.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      
      // Lightbox keyboard
      document.addEventListener('keydown', function(e) {
        if (document.getElementById('lightbox').classList.contains('open')) {
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') lightboxPrev();
          if (e.key === 'ArrowRight') lightboxNext();
        }
      });
      
      // Lightbox click to close
      var lightbox = document.getElementById('lightbox');
      if (lightbox) {
        lightbox.addEventListener('click', function(e) {
          if (e.target === lightbox) closeLightbox();
        });
      }

      // Mobile menu - with null checks
      var mobileMenuBtn = document.getElementById('mobileMenuBtn');
      var mobileNav = document.getElementById('mobileNav');
      var mobileNavOverlay = document.getElementById('mobileNavOverlay');
      var mobileNavClose = document.getElementById('mobileNavClose');

      if (!mobileMenuBtn || !mobileNav) {
        console.warn('Mobile menu elements not found');
      } else {

      function openMobileNav() {
        mobileMenuBtn.classList.add('active');
        mobileNav.classList.add('open');
        if (mobileNavOverlay) mobileNavOverlay.classList.add('open');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }

      function closeMobileNav() {
        mobileMenuBtn.classList.remove('active');
        mobileNav.classList.remove('open');
        if (mobileNavOverlay) mobileNavOverlay.classList.remove('open');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }

      mobileMenuBtn.addEventListener('click', function() {
        if (mobileNav.classList.contains('open')) {
          closeMobileNav();
        } else {
          openMobileNav();
        }
      });

      if (mobileNavClose) mobileNavClose.addEventListener('click', closeMobileNav);
      if (mobileNavOverlay) mobileNavOverlay.addEventListener('click', closeMobileNav);

      // Mobile nav links - close on click
      if (mobileNav) {
        mobileNav.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', closeMobileNav);
        });
      }
      } // end null check
    });
    
    // Cleanup on page unload
    window.addEventListener('beforeunload', function() {
      if (AppState.heroSlider) {
        clearInterval(AppState.heroSlider);
      }
      stopNewsAutoplay();
    });
  </script>

</body>
</html>
